      "source_duration": 26.08,
      "edited_source_duration": 26.08,
      "source_edit_plan_sha256": "53cfd22995fcf4c2c252a351f25e0626983a274f2e9608b1cc691729caf2d5e2",
      "source_edits": [],
      "final_duration": 23.254625,
      "alignment": "res://episodes/episode_001/audio/processed/r8_6_0_88e00209a069_tempo1.120.words.json",
