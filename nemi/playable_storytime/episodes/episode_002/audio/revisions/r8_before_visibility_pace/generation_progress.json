  "clips": [
    {
      "id": "drawing_hook",
      "author": "nemi",
      "file": "res://episodes/episode_002/audio/source/drawing_hook_d1745bc779ce.wav",
      "sha256": "5b6665c773f261bb71e6bbe0d790fcac4ad07a0e7e0d6375f6c072fe665ce14a",
      "text": "I drew this place, and that eraser is eating the floor. I'm on that floor. Click and drag to look around, or swipe on your phone. Find the door to your left or the tear to your right, then press one for the door, or two for the tear.",
      "at": 0.35,
      "start": 0,
      "end": 17.28,
      "tempo": 1.0,
      "end_at": 17.63,
