  "script": [
    {
      "actor": "nemi",
      "start": 0.0,
      "end": 2.56,
      "text": "A message to every storytime animator."
    },
    {
      "actor": "nemi",
      "start": 3.54,
      "end": 4.5,
      "text": "My name's Nemi."
    },
    {
      "actor": "nemi",
      "start": 6.06,
      "end": 7.34,
      "text": "I'm an overthinker."
    },
    {
      "actor": "nemi",
      "start": 9.24,
      "end": 11.56,
      "text": "And I'm gonna steal your watch time."
    },
    {
      "actor": "nemi",
      "start": 11.58,
      "end": 14.23,
      "text": "By becoming the biggest storytime animator in the world."
    },
    {
      "actor": "nemi",
      "start": 18.56,
      "end": 19.84,
      "text": "I've already got the stories."
    },
    {
      "actor": "nemi",
      "start": 19.87,
      "end": 22.05,
      "text": "Now I just gotta stop overthinking."
    }
  ],
