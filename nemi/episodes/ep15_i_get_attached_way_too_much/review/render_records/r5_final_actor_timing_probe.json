_position)\n   if previous_city_valid:city_max_origin_step=maxf(city_max_origin_step,wp.distance_to(previous_city_position))\n   previous_city_position=wp\n   previous_city_valid=true\n   var minp=Vector2(INF,INF)\n   var maxp=Vector2(-INF,-INF)\n   for vertex in [Vector2(-23,-60),Vector2(-16,-66),Vector2(17,-62),Vector2(25,-53),Vector2(22,19),Vector2(15,26),Vector2(-17,23),Vector2(-25,16)]:\n    var p=city_phone.to_global(vertex)\n    minp=minp.min(p)\n    maxp=maxp.max(p)\n   if minp.x<0 or minp.y<0 or maxp.x>1920 or maxp.y>1080:city_offscreen_frames.append({\"frame\":frame,\"at\":t,\"min\":xy(minp),\"max\":xy(maxp)})\n var rows=[]\n for t in [23.618888,23.618889,23.618890,26.090741,35.183704,36.283704,38.703704,39.203704,41.103704,43.603704,46.963703,46.963704,46.963705,135.688147,135.688148,137.768147,137.768148,137.768149,137.898148,138.418147,138.418148,138.418149,142.468147,142.468148,147.128148,150.199999]:\n  stage.sample(t)\n  var use_city=t<100\n  var actor=city if use_city else main\n  var phone=city_phone if use_city else final_phone\n  var visible_hand_shapes={}\n  for id in visible_ids(stage):visible_hand_shapes[id]=stage.actors[id].node.right_hand_visual.hand_pose\n  rows.append({\"at\":t,\"shot\":stage.current_shot,\"visible_instances\":visible_ids(stage),\"phone_visible\":phone.visible,\n   \"sampled_actor\":\"nemi_city\" if use_city else \"nemi\",\"visible_right_hand_shapes\":visible_hand_shapes,\n   \"hand_actor_local\":xy(actor.to_local(actor.right_hand_bone.global_position)),\"hand_world\":xy(stage.world.to_local(actor.right_hand_bone.global_position)),\n   \"hand_angle\":rad_to_deg(actor.right_hand_bone.global_rotation),\"right_hand_shape\":actor.right_hand_visual.hand_pose,\n   \"phone_world\":xy(stage.world.to_local(phone.global_position)),\"phone_tilt\":phone.rotation_degrees,\n   \"socket_grip_distance_screen_pixels\":actor.right_hand_bone.to_global(Vector2(0,8)).distance_to(phone.to_global(Vector2(0,11))),\n   \"phone_bottom_world_y\":stage.world.to_local(phone.to_global(Vector2(25,0))).y})\n print(\"FINAL_ALIAS_STAGE \",JSON.stringify({\"frame_count\":int(round(float(stage.spec.duration)*float(stage.spec.fps))),\"visibility_violations\":visibility_violations,\n  \"city_frame_count\":city_frame_count,\"city_max_contact_error_screen_pixels\":city_max_contact_error,\"city_max_origin_step_world_pixels\":city_max_origin_step,\n  \"city_hand_shape_violations\":city_hand_shape_violations,\"city_phone_offscreen_frames\":city_offscreen_frames,\"boundary_rows\":rows}))\n quit()\n"
