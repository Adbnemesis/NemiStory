{
  "name": "adb-nemi-shorts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "check": "tsc --noEmit && node --import tsx tools/validate.ts && node --import tsx --test tests/*.test.ts",
    "render": "node --import tsx tools/render.ts",
    "new": "node --import tsx tools/new-short.ts"
  },
  "dependencies": {
    "remotion": "4.0.443",
    "@remotion/cli": "4.0.443",
    "@remotion/bundler": "4.0.443",
    "@remotion/renderer": "4.0.443",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "@types/react": "19.1.16",
    "@types/node": "22.18.6"
  }
}
