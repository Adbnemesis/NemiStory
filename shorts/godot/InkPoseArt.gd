var ink := Color("#282728")
var paper := Color("#e8e8e5")
var width_main := 1.9

func v(a: Array) -> Vector2: return Vector2(a[0],a[1])
func curve(points: Array, width := 1.9, fill := false, colour := Color.TRANSPARENT) -> void:
	var path = Curve2D.new()
	path.add_point(v(points[0]))
	# A chain of cubic Beziers, explicitly authored control points.
	var previous = 0
	for j in range(1,points.size()-2,3):
		path.set_point_out(previous,v(points[j])-path.get_point_position(previous))
		path.add_point(v(points[j+2]),v(points[j+1])-v(points[j+2]))
		previous += 1
	if (points.size()-1)%3 != 0: path.add_point(v(points[-1]))
	path.bake_interval = 1.2
	var pts = path.get_baked_points()
	if fill: draw_colored_polygon(pts,paper if colour == Color.TRANSPARENT else colour)
	draw_polyline(pts,ink,width,true)

func line(points: Array, width := 1.2) -> void:
	var p := PackedVector2Array()
	for point in points: p.append(v(point))
	draw_polyline(p,ink,width,true)

func _draw() -> void:
	if smear:
		curve([[-210,-370],[-110,-358],[85,-358],[200,-342]],1.0)
		curve([[-240,-238],[-88,-234],[103,-222],[236,-215]],1.4)
		curve([[-208,-132],[-110,-127],[107,-122],[199,-109]],.8)
	if view == "back": draw_back();return
	if author == "nemi": draw_nemi_hair()
	draw_body()
	if author == "nemi": draw_nemi_head()
	else: draw_adb_head()
	if emotion == "shy" or emotion == "cover": draw_shy_hand()
	if view == "profile": draw_profile_face()
	else: draw_face()

