; Isolated portrait Shorts project. Asset links are prepared in a temporary checkout.
config_version=5

[application]
config/name="ADB + Nemi Ink Shorts"
run/main_scene="res://shorts/godot/ink-proof/InkEdit.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=1080
window/size/window_height_override=1920
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.91, 0.91, 0.91, 1)
