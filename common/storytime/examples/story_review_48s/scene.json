  "script": [
    {
      "actor": "nemi",
      "start": 0.7,
      "end": 4.06,
      "text": "I was going to draw one tiny thing before bed. Just one."
    },
    {
      "actor": "nemi",
      "start": 4.8,
      "end": 11.244444444444444,
      "text": "First, I needed the perfect setup. Apparently, drawing required interior design."
    },
    {
      "actor": "adb",
      "start": 11.9,
      "end": 14.540000000000001,
      "text": "So naturally, she made a plan for the plan."
    },
    {
      "actor": "nemi",
      "start": 15.2,
      "end": 19.771428571428572,
      "text": "A notebook. A coffee. And a completely unnecessary number of tabs."
    },
    {
      "actor": "adb",
      "start": 20.5,
      "end": 23.94,
      "text": "The coffee was ready. The drawing was still a theory."
    },
    {
      "actor": "adb",
      "start": 24.5,
      "end": 27.22,
      "text": "I picked up my mug. She opened another window."
    },
    {
      "actor": "nemi",
      "start": 28.6,
      "end": 33.1925925925926,
      "text": "Okay. No more planning. One line, and then another."
    },
    {
      "actor": "nemi",
      "start": 33.9,
      "end": 37.18,
      "text": "Then I finally drew the thing. It was a circle."
    },
    {
      "actor": "adb",
      "start": 38.1,
      "end": 41.86,
      "text": "Forty minutes of preparation. A very professional potato."
    },
    {
      "actor": "adb",
      "start": 42.5,
      "end": 46.02,
      "text": "Honestly? Give it eyes. Now it has a career."
    }
  ],
