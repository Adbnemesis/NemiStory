# Godot 4+ specific ignores
.godot/
/android/

# OS and system files
.DS_Store
Thumbs.db

# Node dependencies
node_modules/

# Python cache
__pycache__/
*.pyc

# Video files and raw captures
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Episode previews, render outputs, and heavy audio stems
episodes/**/previews/
