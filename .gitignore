# Godot 4+ specific ignores
.godot/
/android/

# OS and system files
.DS_Store
Thumbs.db

# Node dependencies
node_modules/

# Python cache
__pycache__/
*.pyc

# Video files and raw captures
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Episode previews, render outputs, and heavy audio stems
**/previews/
**/renders/*.mp4
**/renders/*.avi
*sfx_only.wav

# Heavy background ambience audio stems
common/audio/sfx/ambience/*.wav
audio/sfx/ambience/*.wav

# Render outputs
renders/raw_*

# Scratch analysis and temporary files
scratch/

# Python virtual environment
.venv/

# Archived rejected artifacts
archive/

# Intermediate TTS segment iterations and backups
audio/nemi/intro/segments_*/

# Temporary transcription artifacts
*.srt
*.vtt
*.tsv

